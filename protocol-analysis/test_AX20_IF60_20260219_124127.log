// Newline Quirks: Look-ahead buffer and swallowed CR testing
[ 0x0A, 0x0D ] = [ 0x9F ] // LF then CR with 10s wait — Testing if CR is sitting in a timeout buffer and eventually outputs 0x9E.
[ 0x0A, 0x0D, 0x20 ] = [ 0x9F, 0x9E, 0xB1, 0x00 ] // LF then CR then Space — Testing if an immediate printable char forces the look-ahead buffer to flush the swallowed CR.
[ 0x0D, 0x0D, 0x0D, 0x58 ] = [ 0x9E, 0xB1, 0x9E, 0xB1, 0x9E, 0xB1, 0x58 ] // 3x CR followed by "X" — Testing if a printable char resets the swallow state, preventing the second CR from being dropped.
