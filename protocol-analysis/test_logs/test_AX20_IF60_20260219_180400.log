// Brother Serial Interface Protocol Test
// Date: 2026-02-19 18:01:55
// Interface: IF60
// Typewriter: AX20
// Keyboard: 1
// Interface PITCH Selection: 10 (Default 10)
// DIP Switches: 0b11111111111000 (0x3FF8)
//
//   1-1: UP    UP=RS-232C, DOWN=CDCC interface
//   1-2: UP    UP=Terminal mode, DOWN=Printer mode
//   1-3: UP    USA users can ignore
//   1-4: DOWN  UP=ASCII Wheel, DOWN=Non-ASCII Wheel
//   1-5: DOWN  UP=12-inch paper, DOWN=11-inch paper
//   1-6: DOWN  UP=Auto skip perforation, DOWN=Non auto skip
//   2-1: DOWN  UP=Local echo (half-duplex), DOWN=No echo (full-duplex)
//   2-2: DOWN  UP=DC-1/DC-3 disabled, DOWN=enabled
//   2-3: DOWN  UP=Auto line feed off, DOWN=Double spacing
//   2-4: DOWN  UP=7-bit data, DOWN=8-bit data
//   2-5: DOWN  UP=Even parity, DOWN=Odd parity
//   2-6..2-8: 111  Baud: 9600
//

// ESC + US + n / ESC + RS + n: HMI and VMI
[ 0x1B, 0x1F, 0x09 ] = [ 0xB3 ] // HMI=9, 15cpi — narrowest pitch
[ 0x1B, 0x1F, 0x0B ] = [ 0xB2 ] // HMI=11, 12cpi — medium pitch
[ 0x1B, 0x1F, 0x0D ] = [ 0xB1 ] // HMI=13, 10cpi — widest pitch
[ 0x1B, 0x1F, 0x0D ] = [ 0xB1 ] // Send again when HMI already 13 — is response identical?
[ 0x1B, 0x1E, 0x09 ] = None // VMI=9 — tightest line spacing
[ 0x1B, 0x1E, 0x0D ] = None // VMI=13 — default 1/6 inch
[ 0x1B, 0x1E, 0x11 ] = None // VMI=17 — wider spacing
[ 0x1B, 0x1E, 0x19 ] = None // VMI=25 — widest spacing

// Pitch byte after CR repositioning
[ 0x0D ] = [ 0x9E, 0xB2, 0x8B, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 ] // CR with left margin at 12cpi — trailing 0xB2?

// Pitch change at left margin vs col 1
[ 0x1B, 0x1F, 0x0B ] = None // Set 12cpi at col 17 (left margin) — accepted or swallowed?
[ 0x1B, 0x1F, 0x0B ] = [ 0xB2 ] // Set 12cpi at col 1 (no margin) — baseline
